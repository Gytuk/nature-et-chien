---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import RelatedArticles from "../components/RelatedArticles.astro";
import TableOfContents from "../components/TableOfContents.astro";

interface RelatedItem { title: string; href: string; category: string; }

interface Heading { depth: number; slug: string; text: string; }

interface Props {
  title: string;
  description: string;
  metaTitle?: string;
  metaDescription?: string;
  category: "avant-de-partir" | "sante" | "equipement";
  publishDate: Date;
  updatedDate?: Date;
  isAffiliate?: boolean;
  related?: RelatedItem[];
  headings?: Heading[];
  image?: string;
  imageAlt?: string;
}

const {
  title,
  description,
  metaTitle,
  metaDescription,
  category,
  publishDate,
  updatedDate,
  isAffiliate = false,
  related = [],
  headings = [],
  image,
  imageAlt,
} = Astro.props;

const categoryMeta: Record<string, { label: string; href: string }> = {
  "avant-de-partir": { label: "Avant de partir",   href: "/avant-de-partir" },
  "sante":           { label: "Santé & bien-être", href: "/sante-bien-etre" },
  "equipement":      { label: "Équipement",        href: "/equipement" },
};

const { label: catLabel, href: catHref } = categoryMeta[category];

const dateFormatted = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric", month: "long", year: "numeric"
}).format(publishDate);

const updatedFormatted = updatedDate
  ? new Intl.DateTimeFormat("fr-FR", { day: "numeric", month: "long", year: "numeric" }).format(updatedDate)
  : null;

const seoTitle = metaTitle ?? title;
const seoDesc  = metaDescription ?? description;

// Schema.org BreadcrumbList
const breadcrumbSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Accueil", "item": "https://nature-et-chien.fr" },
    { "@type": "ListItem", "position": 2, "name": catLabel, "item": `https://nature-et-chien.fr${catHref}` },
    { "@type": "ListItem", "position": 3, "name": title }
  ]
});

// Schema.org Article
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": title,
  "description": description,
  "datePublished": publishDate.toISOString(),
  ...(updatedDate && { "dateModified": updatedDate.toISOString() }),
  ...(image && {
    "image": {
      "@type": "ImageObject",
      "url": new URL(image, "https://nature-et-chien.fr").href,
      "width": 800,
      "height": 400
    }
  }),
  "author": {
    "@type": "Person",
    "name": "Nature & Chien"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Nature & Chien",
    "url": "https://nature-et-chien.fr",
    "logo": {
      "@type": "ImageObject",
      "url": "https://nature-et-chien.fr/logo-transparent.png"
    }
  },
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": `https://nature-et-chien.fr${Astro.url.pathname}`
  }
});
---

<BaseLayout title={seoTitle} description={seoDesc} ogImage={image} ogType="article">
  <script type="application/ld+json" set:html={breadcrumbSchema} />
  <script type="application/ld+json" set:html={schema} />

  <div class="article-wrapper">
    <div class="container article-container">

      <!-- Breadcrumb -->
      <Breadcrumb items={[
        { label: catLabel, href: catHref },
        { label: title }
      ]} />

      <!-- Image de couverture -->
      {image && (
        <div class="article-cover">
          <img
            src={image}
            alt={imageAlt ?? title}
            class="article-cover-img"
            loading="eager"
            decoding="async"
            width="800"
            height="400"
          />
        </div>
      )}

      <!-- En-tête article -->
      <header class="article-header">
        <div class="article-meta-top">
          <span class:list={["badge", `badge-${category === "avant-de-partir" ? "avant" : category === "sante" ? "sante" : "equipement"}`]}>
            {catLabel}
          </span>
          {isAffiliate && (
            <span class="affiliate-tag-header">Guide d'achat</span>
          )}
        </div>

        <h1 class="article-title">{title}</h1>
        <p class="article-desc">{description}</p>

        <div class="article-dates">
          {updatedFormatted ? (
            <time datetime={updatedDate?.toISOString()}>Modifié le {updatedFormatted}</time>
          ) : (
            <time datetime={publishDate.toISOString()}>Publié le {dateFormatted}</time>
          )}
        </div>
      </header>

      <!-- Sommaire cliquable -->
      {headings.length > 2 && <TableOfContents headings={headings} />}

      <!-- Mention affilié dans le markdown de chaque article, après l'intro -->

      <!-- Contenu -->
      <div class="prose article-content">
        <slot />
      </div>

      <!-- Articles liés -->
      {related.length > 0 && <RelatedArticles items={related} />}

    </div>
  </div>
</BaseLayout>

<style>
.article-wrapper {
  padding: 2rem 0 4rem;
  background: var(--color-cream);
}

.article-container {
  max-width: 800px;
}

.article-header { margin-bottom: 2rem; }

.article-meta-top { display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem; }
.affiliate-tag-header {
  font-size: 0.74rem; font-weight: 600; color: var(--color-bark);
  background: var(--color-earth-light); padding: 0.18rem 0.6rem;
  border-radius: 999px; text-transform: uppercase; letter-spacing: 0.03em;
}

.article-title {
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 4vw, 2.2rem);
  font-weight: 700;
  line-height: 1.2;
  color: var(--color-text);
  margin: 0 0 0.75rem;
}

.article-desc {
  font-size: 1.05rem;
  color: var(--color-text-soft);
  line-height: 1.6;
  margin: 0 0 1rem;
}

.article-dates {
  font-size: 0.82rem;
  color: #aaa;
}

.article-cover {
  border-radius: var(--radius-lg);
  overflow: hidden;
  margin-bottom: 2rem;
  max-height: 420px;
}
.article-cover-img {
  width: 100%;
  height: 100%;
  max-height: 420px;
  object-fit: cover;
  display: block;
}

.article-content {
  margin-top: 1rem;
}
</style>
