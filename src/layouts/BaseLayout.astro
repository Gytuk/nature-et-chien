---
import SEO from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  noindex?: boolean;
  ogType?: string;
  titleSuffix?: boolean;
}

const { title, description, canonicalUrl, ogImage, ogImageWidth, ogImageHeight, noindex, ogType, titleSuffix } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <SEO {title} {description} {canonicalUrl} {ogImage} {ogImageWidth} {ogImageHeight} {noindex} {ogType} {titleSuffix} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
