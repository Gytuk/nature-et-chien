---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}
interface Props { headings: Heading[]; }
const { headings } = Astro.props;

// Uniquement les H2 — les H3 alourdissent le sommaire
const toc = headings.filter(h => h.depth === 2);
---

{toc.length > 1 && (
  <nav class="toc" aria-label="Sommaire de l'article">
    <div class="toc-header">
      <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" d="M4 6h16M4 10h12M4 14h8"/>
      </svg>
      <span>Sommaire</span>
    </div>
    <ol class="toc-list">
      {toc.map(heading => (
        <li class="toc-item">
          <a href={`#${heading.slug}`} class="toc-link">
            {heading.text}
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
.toc {
  background: #f0faf4;
  border: 1.5px solid var(--color-forest-pale);
  border-left: 4px solid var(--color-forest-light);
  border-radius: var(--radius-md);
  padding: 1.25rem 1.5rem;
  margin: 0 0 2.5rem;
  font-size: 0.92rem;
}

.toc-header {
  display: flex; align-items: center; gap: 0.5rem;
  font-family: var(--font-serif); font-weight: 700;
  font-size: 0.95rem; color: var(--color-forest);
  margin-bottom: 0.9rem;
}

.toc-list {
  list-style: none; padding: 0; margin: 0;
  display: flex; flex-direction: column; gap: 0.4rem;
  counter-reset: toc-counter;
}

.toc-item { counter-increment: toc-counter; }

.toc-link {
  color: var(--color-text);
  text-decoration: none;
  line-height: 1.5;
  display: flex; align-items: baseline; gap: 0.5rem;
  transition: color 0.15s;
}
.toc-link::before {
  content: counter(toc-counter) ".";
  font-size: 0.78rem; font-weight: 700;
  color: var(--color-forest-light);
  flex-shrink: 0; min-width: 1.2rem;
}
.toc-link:hover { color: var(--color-forest); text-decoration: none; }
</style>
