---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("avant-de-partir")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Avant de partir en randonnée avec son chien — Conseils et guides"
  description="Législation, distances adaptées, randonnée avec un chiot : tous nos guides pour bien préparer vos sorties avec votre chien."
>

  <!-- Bandeau haut avec image de fond -->
  <section class="pillar-hero">
    <img
      src="/images/shared/bandeau-avant-depart.jpg"
      alt="Paysage de randonnée — préparer sa sortie avec son chien en toute sécurité"
      class="pillar-hero-img"
      loading="eager"
    />
    <div class="pillar-hero-overlay"></div>
    <div class="container pillar-hero-content">
      <div class="pillar-icon">🗺️</div>
      <h1 class="pillar-title">Avant de partir</h1>
      <p class="pillar-intro">
        Préparer une randonnée avec son chien ne s'improvise pas. Législation, distances adaptées,
        initiation des chiots, bonnes pratiques avant le départ : trouvez ici les réponses à
        vos questions avant de vous élancer sur les sentiers.
      </p>
    </div>
  </section>

  <section class="pillar-articles">
    <div class="container">
      {articles.length === 0 ? (
        <p>Aucun article pour le moment — revenez bientôt !</p>
      ) : (
        <div class="articles-grid">
          {articles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              href={`/avant-de-partir/${article.id}`}
              category={article.data.category}
              isAffiliate={article.data.isAffiliate}
              featured={article.data.featured}
              publishDate={article.data.publishDate}
              image={article.data.image}
            />
          ))}
        </div>
      )}
    </div>
  </section>

</BaseLayout>

<!-- Styles mutualisés dans global.css -->
