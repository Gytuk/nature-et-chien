---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = (await getCollection("sante")).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
);
---

<BaseLayout
  title="Santé et bien-être du chien en randonnée — Conseils pratiques"
  description="Hydratation, coussinets, fatigue, chaleur : nos guides santé pour que votre chien reste en forme avant, pendant et après la randonnée."
>

  <section class="pillar-hero">
    <img
      src="/images/sante/bandeau-sante.jpg"
      alt="Chien fatigué après l'effort en randonnée — santé et bien-être du chien"
      class="pillar-hero-img"
      loading="eager"
    />
    <div class="pillar-hero-overlay"></div>
    <div class="container pillar-hero-content">
      <div class="pillar-icon">🐾</div>
      <h1 class="pillar-title">Santé &amp; bien-être</h1>
      <p class="pillar-intro">
        Sur les sentiers, votre chien donne toute son énergie pour vous suivre. Hydratation,
        protection des coussinets, gestion de la fatigue et de la chaleur : trouvez ici les
        conseils essentiels pour préserver sa santé avant, pendant et après l'effort.
      </p>
    </div>
  </section>

  <section class="pillar-articles">
    <div class="container">
      {articles.length === 0 ? (
        <p>Aucun article pour le moment — revenez bientôt !</p>
      ) : (
        <div class="articles-grid">
          {articles.map(article => (
            <ArticleCard
              title={article.data.title}
              description={article.data.description}
              href={`/sante-bien-etre/${article.id}`}
              category={article.data.category}
              isAffiliate={article.data.isAffiliate}
              featured={article.data.featured}
              publishDate={article.data.publishDate}
              image={article.data.image}
            />
          ))}
        </div>
      )}
    </div>
  </section>

</BaseLayout>

<!-- Styles mutualisés dans global.css -->
<style>
/* Recadrage spécifique à la photo santé — centre sur le chien (milieu-bas) */
.pillar-hero-img { object-position: center 70%; }
</style>
