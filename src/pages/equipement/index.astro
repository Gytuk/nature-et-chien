---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArticleCard from "../../components/ArticleCard.astro";
import { getCollection } from "astro:content";

const articles = await getCollection("equipement");

const harnaisArticles = articles
  .filter(a => a.data.theme === "harnais")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const hydratationArticles = articles
  .filter(a => a.data.theme === "hydratation")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const laisseArticles = articles
  .filter(a => a.data.theme === "laisse")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const ceintureBaudierArticles = articles
  .filter(a => a.data.theme === "ceinture-canicross")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const soinArticles = articles
  .filter(a => a.data.theme === "soin")
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Équipement de randonnée pour chien — Guides et comparatifs"
  description="Harnais, gourdes, gamelles, accessoires : nos guides d'achat et comparatifs pour choisir l'équipement adapté à votre chien et à votre pratique."
>

  <section class="pillar-hero">
    <img
      src="/images/avant-de-partir/bandeau-paysage.jpg"
      alt="Chien en randonnée équipé — guide harnais, gourdes et accessoires"
      class="pillar-hero-img"
      loading="eager"
    />
    <div class="pillar-hero-overlay"></div>
    <div class="container pillar-hero-content">
      <div class="pillar-icon">🎒</div>
      <h1 class="pillar-title">Équipement</h1>
      <p class="pillar-intro">
        Le bon matériel se choisit selon votre pratique, votre terrain et la morphologie de
        votre chien. Nos guides et comparatifs vous aident à sélectionner les accessoires
        qui améliorent réellement votre confort mutuel — sans accumulation inutile.
      </p>
    </div>
  </section>

  <section class="pillar-articles">
    <div class="container">

      {harnaisArticles.length > 0 && (
        <div class="theme-section" id="harnais">
          <h2 class="theme-section-title">Harnais</h2>
          <div class="articles-grid">
            {harnaisArticles.map(article => (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={`/equipement/${article.id}`}
                category={article.data.category}
                isAffiliate={article.data.isAffiliate}
                featured={article.data.featured}
                publishDate={article.data.publishDate}
                image={article.data.image}
              />
            ))}
          </div>
        </div>
      )}

      {hydratationArticles.length > 0 && (
        <div class="theme-section" id="hydratation">
          <h2 class="theme-section-title">Hydratation</h2>
          <div class="articles-grid">
            {hydratationArticles.map(article => (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={`/equipement/${article.id}`}
                category={article.data.category}
                isAffiliate={article.data.isAffiliate}
                featured={article.data.featured}
                publishDate={article.data.publishDate}
                image={article.data.image}
              />
            ))}
          </div>
        </div>
      )}

      {laisseArticles.length > 0 && (
        <div class="theme-section" id="laisse">
          <h2 class="theme-section-title">Laisse et longe</h2>
          <div class="articles-grid">
            {laisseArticles.map(article => (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={`/equipement/${article.id}`}
                category={article.data.category}
                isAffiliate={article.data.isAffiliate}
                featured={article.data.featured}
                publishDate={article.data.publishDate}
                image={article.data.image}
              />
            ))}
          </div>
        </div>
      )}

      {ceintureBaudierArticles.length > 0 && (
        <div class="theme-section" id="ceinture-baudrier">
          <h2 class="theme-section-title">Ceinture et baudrier</h2>
          <div class="articles-grid">
            {ceintureBaudierArticles.map(article => (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={`/equipement/${article.id}`}
                category={article.data.category}
                isAffiliate={article.data.isAffiliate}
                featured={article.data.featured}
                publishDate={article.data.publishDate}
                image={article.data.image}
              />
            ))}
          </div>
        </div>
      )}

      {soinArticles.length > 0 && (
        <div class="theme-section" id="soin">
          <h2 class="theme-section-title">Soins</h2>
          <div class="articles-grid">
            {soinArticles.map(article => (
              <ArticleCard
                title={article.data.title}
                description={article.data.description}
                href={`/equipement/${article.id}`}
                category={article.data.category}
                isAffiliate={article.data.isAffiliate}
                featured={article.data.featured}
                publishDate={article.data.publishDate}
                image={article.data.image}
              />
            ))}
          </div>
        </div>
      )}

    </div>
  </section>

</BaseLayout>

<style>
.theme-section {
  margin-bottom: 3.5rem;
  scroll-margin-top: 96px;
}
.theme-section-title {
  font-family: var(--font-serif);
  font-size: 1.35rem;
  font-weight: 700;
  color: var(--color-forest);
  margin-bottom: 1.5rem;
  padding-bottom: 0.5rem;
  border-bottom: 2px solid var(--color-forest-pale);
}
</style>
